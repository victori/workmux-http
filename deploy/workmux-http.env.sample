# workmux-http service environment — copy to e.g. /usr/local/etc/workmux-http.env
# (Linux: /etc/workmux-http.env) and chmod 600 if commit/push cmds embed tokens.
# Sourced by the launchd, systemd, and rc.d units; every variable is optional
# unless noted (defaults shown are the built-in ones).

# --- listen ---
WORKMUX_HTTP_BIND=127.0.0.1
WORKMUX_HTTP_PORT=3000
# Wildcard binds (0.0.0.0 / ::) are refused at startup unless set to 1.
# The Host allowlist stays enforced either way.
#WORKMUX_HTTP_ALLOW_WILDCARD=1

# --- security (no login by design; VPN/loopback is the boundary) ---
# Comma-separated hostnames accepted in the Host header. Include your
# VPN/LAN address, e.g. vpn.example.ts.net,10.8.0.5
WORKMUX_ALLOWED_HOSTS=localhost
# '*' accepts ANY Host and is DNS-rebinding exposed — never the default.
#WORKMUX_ALLOWED_HOSTS=*

# --- discovery ---
# tmux socket the dashboard drives. Set this explicitly for services:
# the default is resolved per-user via `tmux`, which depends on PATH.
#WORKMUX_TMUX_SOCKET=/tmp/tmux-1000/default
# Extra repos to scan beyond workmux's own list (colon-separated).
#WORKMUX_REPOS=~/code/api:~/code/web

# --- behavior ---
# Seconds an idle agent stays "fresh" before a Stale badge.
#WORKMUX_HTTP_STALE_AFTER=3600
# Concurrent advanced-terminal (owned tmux session) cap.
#WORKMUX_HTTP_MAX_OWNED_TERMINALS=4

# --- timeouts ---
#WORKMUX_COMMIT_TIMEOUT_MS=300000
#WORKMUX_PUSH_TIMEOUT_MS=120000

# --- direct commit/push runners (per agent kind; button appears when set) ---
# {{COMMIT_MSG}} receives the message. Quote for your shell here.
#WORKMUX_OMP_COMMIT_CMD='omp commit --message "{{COMMIT_MSG}}"'
#WORKMUX_OMP_PUSH_CMD='omp push'

# --- fixture mode (demo/offline; advanced terminal refuses) ---
#WORKMUX_HTTP_FIXTURES=/path/to/fixtures
